{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Lajur": {
    "Auth": {
      "Issuer": "Lajur",
      "Audience": "Lajur.Android",
      "AccessTokenMinutes": 15,
      "RefreshTokenIdleDays": 30,
      "RefreshTokenAbsoluteDays": 180
    },
    "Storage": {
      "RootPath": ".local/lajur"
    }
  },
  "AllowedHosts": "*"
}
