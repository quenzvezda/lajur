# Host-only file: /etc/lajur/production.env, root-owned with mode 0600.
# Fill these from docker image inspect / docker network inspect during bootstrap.
# Keep the actual file outside Git, even though these two values are not secrets.
LAJUR_IMAGE=sha256:REPLACE_WITH_VERIFIED_LOCAL_IMAGE_ID
LAJUR_TRUSTED_PROXY_CIDR=REPLACE_WITH_LAJUR_NETWORK_GATEWAY/32
