# Local port bound only to loopback.
LAJUR_API_PORT=8080

# Docker network the host reverse proxy reaches the container from (X-Forwarded-* is trusted only
# from here). Adjust if the Docker bridge uses another range.
# LAJUR_TRUSTED_PROXY_NETWORK=172.16.0.0/12

# Optional production host paths. Uncomment and adjust on the VPS.
# LAJUR_DATA_PATH=/srv/lajur/data
# LAJUR_BACKUPS_PATH=/srv/lajur/backups
# LAJUR_TEMPLATES_PATH=/srv/lajur/templates
# LAJUR_AUTH_PATH=/srv/lajur/auth
# LAJUR_KEYS_PATH=/srv/lajur/keys
# LAJUR_STAGING_PATH=/srv/lajur/staging
